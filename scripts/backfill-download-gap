#!/usr/bin/env python3
"""
backfill-download-gap — fill missing daily snapshots with download-only stubs.

One-time recovery after a CI outage (e.g. an expired GH_PAT stops the commit
job, so no snapshots are written even though the download jobs succeed).
Python port of `backfill-downloads.ts --gap-only`, so no Node is needed.

  npm    daily counts from the registry range API; total is carried forward
         from the nearest earlier snapshot's total/total_through, the same
         running sum fetchDownloads() keeps.
  PyPI   daily counts summed from versions.json (BigQuery, the source CI uses);
         total is the running sum, matching deriveDownloadMetrics(). Run this
         after a successful CI run has refreshed versions.json.
  NuGet  no history API, skipped. CI's next run averages the gap.

Only creates files for dates with no snapshot; existing snapshots are never
rewritten. Today is never stubbed (CI owns it). A zero count means the
registry never posted that day (npm has mid-series holes), so it gets no stub
and any rolling sum spanning it is omitted rather than understated.

Usage: python3 scripts/backfill-download-gap [--dry-run]
"""

import argparse
import bisect
import json
import sys
from datetime import date, datetime, timedelta, timezone
from pathlib import Path
from urllib.request import Request, urlopen

DATA = Path("data/repos")
NPM_API = "https://api.npmjs.org/downloads"
# Fetch this far before the first missing date so the carry-forward anchor and
# the 30-day rolling window are both covered.
NPM_LEAD_DAYS = 60


def _days(start: date, end: date) -> list[date]:
    return [start + timedelta(n) for n in range((end - start).days + 1)]


def _load_snapshots(repo_dir: Path) -> dict[date, dict]:
    return {
        date.fromisoformat(p.stem): json.loads(p.read_text(encoding="utf-8"))
        for p in sorted((repo_dir / "snapshots").glob("????-??-??.json"))
    }


def _npm_daily(pkg: str, start: date, end: date) -> dict[date, int]:
    url = f"{NPM_API}/range/{start}:{end}/{pkg}"
    req = Request(url, headers={"User-Agent": "mcp-repo-data-tracker backfill"})
    with urlopen(req, timeout=60) as r:
        data = json.load(r)
    return {date.fromisoformat(d["day"]): d["downloads"] for d in data["downloads"]}


def _pypi_daily(repo_dir: Path) -> dict[date, int]:
    v = json.loads((repo_dir / "versions.json").read_text(encoding="utf-8"))
    return {date.fromisoformat(d): sum(by_ver.values()) for d, by_ver in v["daily"].items()}


def _rolling(daily: dict[date, int], d: date, n: int) -> int | None:
    window = [d - timedelta(i) for i in range(n)]
    if any(w not in daily for w in window):
        return None
    return sum(daily[w] for w in window)


def plan_stubs(registry: str, snaps: dict[date, dict], daily: dict[date, int], today: date) -> list[dict]:
    # Zeros mean "not posted" — trailing ones are lag (npm 1-2 days, BigQuery
    # batches), mid-series ones are registry outages. Treat both as missing.
    daily = {d: n for d, n in daily.items() if n > 0}
    posted = sorted(d for d in daily if d < today)
    if not posted or not snaps:
        return []

    snap_dates = sorted(snaps)
    cumulative: dict[date, int] = {}
    if registry == "pypi":
        running = 0
        for d in sorted(daily):
            running += daily[d]
            cumulative[d] = running

    stubs = []
    total = through = None
    for d in _days(snap_dates[0], posted[-1]):
        if d in snaps:
            dl = snaps[d].get("downloads") or {}
            if dl.get("total") is not None:
                total = dl["total"]
                through = date.fromisoformat(dl.get("total_through", str(d)))
            continue
        if d not in daily:
            continue

        out: dict = {"daily": daily[d]}
        if registry == "npm":
            if total is None:
                continue  # nothing to anchor the running sum on yet
            # Don't run ahead of a later snapshot's anchor, or the cumulative
            # series would dip when it resumes.
            i = bisect.bisect_right(snap_dates, d)
            if i < len(snap_dates):
                nxt = (snaps[snap_dates[i]].get("downloads") or {}).get("total_through")
                if nxt and d > date.fromisoformat(nxt):
                    continue
            if through < min(daily):
                raise RuntimeError(f"npm history starts after anchor {through}; raise NPM_LEAD_DAYS")
            total += sum(daily.get(x, 0) for x in _days(through + timedelta(1), d))
            through = d
            out["total"] = total
            out["total_through"] = str(d)
        else:
            out["total"] = cumulative[d]

        for key, n in (("last_week", 7), ("last_month", 30)):
            s = _rolling(daily, d, n)
            if s is not None:
                out[key] = s
        stubs.append({"date": str(d), "downloads": out})
    return stubs


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--dry-run", action="store_true", help="print planned stubs without writing")
    args = ap.parse_args()

    today = datetime.now(timezone.utc).date()
    config = json.loads(Path("repos.json").read_text(encoding="utf-8"))

    for rc in config["repositories"]:
        pkg = rc.get("package")
        if not pkg:
            continue
        repo_dir = DATA / rc["owner"] / rc["repo"]
        snaps = _load_snapshots(repo_dir)
        if not snaps:
            print(f"[skip] {rc['repo']}: no snapshots")
            continue

        registry = pkg["registry"]
        if registry == "npm":
            missing = [d for d in _days(min(snaps), today - timedelta(1)) if d not in snaps]
            if not missing:
                print(f"[{rc['repo']}] no gaps")
                continue
            daily = _npm_daily(pkg["name"], missing[0] - timedelta(NPM_LEAD_DAYS), today)
        elif registry == "pypi":
            daily = _pypi_daily(repo_dir)
            last = max(daily)
            if last < today - timedelta(1):
                print(f"[{rc['repo']}] warning: versions.json ends {last}; "
                      "gap after that needs a successful CI run first")
        else:
            print(f"[skip] {rc['repo']}: {registry} has no download history API")
            continue

        stubs = plan_stubs(registry, snaps, daily, today)
        if not stubs:
            print(f"[{rc['repo']}] no stubs to create")
            continue
        print(f"[{rc['repo']}] {len(stubs)} stub(s) {stubs[0]['date']}..{stubs[-1]['date']}")
        for s in stubs:
            dl = s["downloads"]
            print(f"  {s['date']}  daily={dl['daily']:>12,}  total={dl['total']:>16,}  last_week={dl.get('last_week', 0):>13,}")
            if not args.dry_run:
                path = repo_dir / "snapshots" / f"{s['date']}.json"
                with open(path, "w", encoding="utf-8", newline="\n") as f:
                    f.write(json.dumps(s, indent=2) + "\n")

    if args.dry_run:
        print("(dry run, nothing written)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
