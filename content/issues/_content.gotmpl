{{- /* /issues/<repo>/: one page per tracked repository (brief 2.1, 3.2b). Each renders layouts/partials/pages/issues.html
     through _default/single.html with params {repo: "owner/repo", page: "issues"}. The title is the bare scope, the H1
     ("TypeScript SDK"); the eyebrow "Issues" comes from the section, so the document title reads "VISR: Issues, TypeScript SDK". */ -}}
{{- range .Site.Data.repos.repositories -}}
  {{- $name := .name | default .repo -}}
  {{- $.AddPage (dict
      "path" .repo
      "kind" "page"
      "title" $name
      "params" (dict "repo" (printf "%s/%s" .owner .repo) "page" "issues")) -}}
{{- end -}}
