{{- /* /repos/<repo>/: one page per tracked repository (brief 2.1, 3.6). Rendered by layouts/partials/pages/repo.html.
  The title is the bare display name (design system v3 §4.2), so the H1 reads "TypeScript SDK" under the eyebrow "Repository" and
  the document title reads "VISR: Repository, TypeScript SDK". */ -}}
{{- range .Site.Data.repos.repositories -}}
  {{- $.AddPage (dict
      "path" .repo
      "kind" "page"
      "title" (.name | default .repo)
      "params" (dict "repo" (printf "%s/%s" .owner .repo) "page" "repo")) -}}
{{- end -}}
