{{- /* /repos/<repo>/: one page per tracked repository (design system v4 5.8). Rendered by layouts/partials/pages/repo.html.
  The title is the bare display name, so the H1 scope switcher reads "TypeScript SDK" under the eyebrow "Repositories" and the
  document title reads "VISR: Repositories, TypeScript SDK". */ -}}
{{- range .Site.Data.repos.repositories -}}
  {{- $.AddPage (dict
      "path" .repo
      "kind" "page"
      "title" (.name | default .repo)
      "params" (dict "repo" (printf "%s/%s" .owner .repo) "page" "repo")) -}}
{{- end -}}
